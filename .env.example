# Optional overrides. Copy to .env.local (git-ignored). Never put private keys here:
# this is a static site, so every VITE_* value ships to the browser.
# Package and Shop IDs come from src/deployment.json (written by `pnpm publish:move`).
# VITE_SUI_NETWORK=testnet
# VITE_PACKAGE_ID=
# VITE_SHOP_ID=
# VITE_WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
# VITE_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# VITE_WALRUS_EPOCHS=5
